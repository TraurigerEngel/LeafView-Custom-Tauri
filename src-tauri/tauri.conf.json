{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeafView Custom — Tauri Edition",
  "identifier": "dev.leafviewcustom.tauri",
  "version": "0.1.2",
  "mainBinaryName": "LeafView Custom Tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LeafView Custom — Tauri Edition",
        "width": 900,
        "height": 600,
        "maximized": true,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#17181c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Минималистичный просмотр изображений",
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "bmp",
          "ico",
          "webp",
          "svg"
        ],
        "name": "LeafView Image",
        "description": "Изображение"
      }
    ]
  }
}
